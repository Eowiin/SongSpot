DJANGO_SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Web client (Flutter web build). Origins that may call the REST API and open
# duel WebSockets. Leave empty in DEBUG to auto-allow any localhost port.
# Native mobile clients send no Origin header and are never affected by these.
CORS_ALLOWED_ORIGINS=https://play.yourdomain.com
# Optional regex allowlist for preview deployments, comma-separated.
CORS_ALLOWED_ORIGIN_REGEXES=
# Defaults to CORS_ALLOWED_ORIGINS when unset.
WEBSOCKET_ALLOWED_ORIGINS=

# Celery / Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Channels (WebSocket fan-out for multi-process setups)
USE_REDIS_CHANNEL_LAYER=True
CHANNEL_LAYERS_REDIS_URL=redis://localhost:6379/1

# Firebase Cloud Messaging (set one of these)
FCM_SERVICE_ACCOUNT_PATH=/absolute/path/to/firebase-service-account.json

# Sentry (error tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
APP_VERSION=1.0.0

# Brevo
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_brevo_login
EMAIL_HOST_PASSWORD=your_brevo_smtp_key
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=SongSpot <no-reply@mail.yourdomain.com>

# Public HTTPS origin used inside password-reset emails.
PASSWORD_RESET_BASE_URL=https://yourdomain.com
# Reset links expire after 1 hour in production.
PASSWORD_RESET_TIMEOUT=3600
# Silently suppress repeat reset emails for the same normalized email.
PASSWORD_RESET_EMAIL_COOLDOWN_SECONDS=900
