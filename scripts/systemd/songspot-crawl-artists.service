[Unit]
Description=Widen the SongSpot catalogue along Deezer's artist graph
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Same account as songspot.service: this VPS has no separate service user,
# and these need the .env and database access the app already runs with.
User=root
WorkingDirectory=/var/www/songspot/songspot_backend
EnvironmentFile=/var/www/songspot/songspot_backend/.env
# --seeds-only misses: start from the searches players actually ran and got
# nothing for, rather than walking Deezer's graph at large. The difference is
# convergence, not thrift. A walk seeded from charts has an effectively endless
# reservoir — it added ~90k tracks an hour for two days straight and showed no
# sign of slowing — while a walk seeded from misses is bounded by what players
# ask for, so it quiets down once the gaps they hit are filled.
ExecStart=/var/www/songspot/songspot_backend/.venv/bin/python manage.py crawl_artists --seeds-only misses

# Paced against a third-party rate limit, so it is slow by design. It must
# never overlap with the next run, and never with refresh_catalog — the two
# would compete for the same forty-requests-per-five-seconds budget.
TimeoutStartSec=5400
