[Unit]
Description=Rebuild SongSpot category pools from scratch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=songspot
WorkingDirectory=/var/www/songspot/songspot_backend
EnvironmentFile=/var/www/songspot/songspot_backend/.env
ExecStart=/var/www/songspot/songspot_backend/.venv/bin/python manage.py refresh_catalog --replace

# Same third-party rate limit as the nightly job, and no category is skipped
# here, so allow more headroom than the --stale-only run gets.
TimeoutStartSec=7200
