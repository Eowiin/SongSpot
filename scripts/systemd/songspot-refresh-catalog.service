[Unit]
Description=Refresh SongSpot category pools from Deezer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=songspot
WorkingDirectory=/var/www/songspot/songspot_backend
EnvironmentFile=/var/www/songspot/songspot_backend/.env
ExecStart=/var/www/songspot/songspot_backend/.venv/bin/python manage.py refresh_catalog --stale-only

# The job talks to a rate-limited third-party API and can legitimately take a
# while; it must never overlap with the next run.
TimeoutStartSec=3600
