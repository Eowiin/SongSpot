default_platform(:android)

platform :android do
  private_lane :track_version_codes do |options|
    begin
      google_play_track_version_codes(
        package_name: "com.songspot.app",
        track: options[:track],
        json_key: "fastlane/google-play-key.json"
      )
    rescue => e
      UI.message("Skipping Play track #{options[:track]} while resolving version code: #{e.message}")
      []
    end
  end

  private_lane :latest_version_code_on do |options|
    codes = track_version_codes(track: options[:track]).compact.map(&:to_i)
    UI.user_error!("No version code found on track #{options[:track]}") if codes.empty?
    codes.max
  end

  private_lane :next_play_store_build_number do
    tracks = %w[internal alpha beta production]
    version_codes = tracks.flat_map { |track| track_version_codes(track: track) }

    latest_version_code = version_codes.compact.map(&:to_i).max || 0
    latest_version_code + 1
  end

  private_lane :play_store_upload_options do |options|
    require "fileutils"

    release_notes = options[:release_notes] || localized_release_notes
    metadata_path = File.expand_path(
      "../../build/fastlane/play_store_metadata/#{Time.now.utc.strftime('%Y%m%d%H%M%S')}",
      __dir__
    )

    release_notes.each do |locale, text|
      changelog_dir = File.join(metadata_path, locale, "changelogs")
      FileUtils.mkdir_p(changelog_dir)
      File.write(File.join(changelog_dir, "default.txt"), "#{text}\n")
    end

    {
      json_key: "fastlane/google-play-key.json",
      metadata_path: metadata_path,
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    }
  end

  private_lane :localized_release_notes do
    {
      "en-US" => (ENV["RELEASE_NOTES_EN"] || "Bug fixes and performance improvements").strip,
      "fr-FR" => (ENV["RELEASE_NOTES_FR"] || "Corrections de bugs et ameliorations des performances").strip
    }
  end

  private_lane :build_aab do
    build_number = next_play_store_build_number
    UI.message("Using Android versionCode #{build_number}")

    Dir.chdir("../..") do
      sh(
        "flutter",
        "build",
        "appbundle",
        "--release",
        "--build-number=#{build_number}",
        "--split-debug-info=build/debug-info",
        "--dart-define=SENTRY_DSN=#{ENV['SENTRY_DSN'] || ''}",
        "--dart-define=SENTRY_ENVIRONMENT=#{ENV['SENTRY_ENVIRONMENT'] || 'production'}"
      )

      UI.user_error!("SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT must be set") unless
        ENV['SENTRY_AUTH_TOKEN'] && ENV['SENTRY_ORG'] && ENV['SENTRY_PROJECT']
      sh("dart", "run", "sentry_dart_plugin")
    end
    {
      aab_path: File.expand_path("../../build/app/outputs/bundle/release/app-release.aab", __dir__),
      version_code: build_number
    }
  end

  desc "Build and upload to internal testing track."
  lane :internal do
    build = build_aab
    release_notes = localized_release_notes
    upload_options = play_store_upload_options(release_notes: release_notes)
    upload_to_play_store(
      track: "internal",
      aab: build[:aab_path],
      version_code: build[:version_code],
      release_status: "completed",
      **upload_options
    )
  end

  desc "Build and upload to internal testing track for beta validation."
  lane :beta do
    internal
  end

  desc "Promote internal track to closed testing (alpha) - no build"
  lane :closed_testing do
    release_notes = localized_release_notes
    upload_options = play_store_upload_options(release_notes: release_notes)
    upload_to_play_store(
      track: "internal",
      track_promote_to: "alpha",
      version_code: latest_version_code_on(track: "internal"),
      **upload_options
    )
  end

  desc "Promote closed testing (alpha) track to production - no build"
  lane :production do
    release_notes = localized_release_notes
    upload_options = play_store_upload_options(release_notes: release_notes)
    upload_to_play_store(
      track: "alpha",
      track_promote_to: "production",
      version_code: latest_version_code_on(track: "alpha"),
      **upload_options
    )
  end

  desc "Build, upload to internal, then promote straight to production."
  lane :play_store do
    build = build_aab
    release_notes = localized_release_notes
    upload_options = play_store_upload_options(release_notes: release_notes)
    upload_to_play_store(
      track: "internal",
      aab: build[:aab_path],
      version_code: build[:version_code],
      release_status: "completed",
      **upload_options
    )
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      version_code: build[:version_code],
      rollout: "1.0",
      **upload_options
    )
  end
end
