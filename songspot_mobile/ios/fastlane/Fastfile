default_platform(:ios)

# ── Version helper ────────────────────────────────────────────────────────────
# Bumps pubspec.yaml version (semver + build number).
# part: "patch" | "minor" | "major"   (default: "patch")
def bump_pubspec(part = "patch")
  pubspec_path = File.expand_path("../../pubspec.yaml", __dir__)
  content = File.read(pubspec_path)
  current = content.match(/^version: (.+)$/)[1]
  semver, build = current.split("+")
  major, minor, patch_v = semver.split(".").map(&:to_i)

  case part
  when "major" then major += 1; minor = 0; patch_v = 0
  when "minor" then minor += 1; patch_v = 0
  when "patch" then patch_v += 1
  else UI.user_error!("bump must be major, minor, or patch (got: #{part})")
  end

  new_build = build.to_i + 1
  new_version = "#{major}.#{minor}.#{patch_v}+#{new_build}"
  File.write(pubspec_path, content.gsub(/^version: .+$/, "version: #{new_version}"))
  UI.success("Version: #{current} → #{new_version}")
  new_version
end

# ─────────────────────────────────────────────────────────────────────────────

platform :ios do
  private_lane :setup_asc_key do
    require 'base64'
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: Base64.decode64(ENV["ASC_P8_FILE"]),
      duration: 1200
    )
  end

  private_lane :build_ipa do |options|
    bump_pubspec(options[:bump] || "patch")

    setup_asc_key

    # Build Flutter before Xcode archive (generates Generated.xcconfig + framework).
    # Running in unbundled env avoids Bundler intercepting `pod` when fastlane is
    # invoked with `bundle exec`.
    Dir.chdir("..") do
      if defined?(Bundler)
        Bundler.with_unbundled_env do
          sh("flutter", "build", "ios", "--release", "--no-codesign")
        end
      else
        sh("flutter", "build", "ios", "--release", "--no-codesign")
      end
    end

    # Build number is managed from TestFlight (independent of pubspec build number)
    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    latest = latest_testflight_build_number(app_identifier: app_id) || 0
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: latest + 1
    )
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Runner",
      export_options: {
        signingStyle: "automatic",
        teamID: "WM42CA5NH5"
      }
    )
    lane_context[SharedValues::IPA_OUTPUT_PATH]
  end

  private_lane :upload_to_store do |options|
    destination = options[:destination]
    ipa_path = options[:ipa]
    changelog = options[:changelog]
    app_store_options = options[:app_store_options] || {}

    UI.user_error!("ipa path is required") if ipa_path.nil?
    UI.user_error!("destination must be :testflight or :app_store") unless [:testflight, :app_store].include?(destination)

    setup_asc_key

    case destination
    when :testflight
      upload_to_testflight(
        ipa: ipa_path,
        changelog: changelog
      )
    when :app_store
      upload_to_app_store(
        { ipa: ipa_path }.merge(app_store_options)
      )
    end
  end

  desc "Bump version, build, and distribute to TestFlight. Options: bump:patch|minor|major"
  lane :testflight do |options|
    ipa_path = build_ipa(bump: options[:bump] || "patch")
    generic_notes = "Bug fixes and performance improvements"
    upload_to_store(
      destination: :testflight,
      ipa: ipa_path,
      changelog: generic_notes
    )
  end

  desc "Bump version, build, and release directly to App Store. Options: bump:patch|minor|major"
  lane :app_store do |options|
    ipa_path = build_ipa(bump: options[:bump] || "patch")
    generic_notes = "Bug fixes and performance improvements"
    upload_to_store(
      destination: :app_store,
      ipa: ipa_path,
      app_store_options: {
        skip_metadata: true,
        skip_screenshots: true,
        precheck_include_in_app_purchases: false,
        release_notes: {
          "en-US" => generic_notes,
          "fr-FR" => generic_notes
        },
        submit_for_review: true,
        automatic_release: true,
        phased_release: false
      }
    )
  end
end
