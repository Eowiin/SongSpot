default_platform(:ios)

platform :ios do
  private_lane :setup_asc_key do
    require 'base64'
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: Base64.decode64(ENV["ASC_P8_FILE"]),
      duration: 1200
    )
  end

  private_lane :localized_release_notes do
    {
      "en-US" => (ENV["RELEASE_NOTES_EN"] || "Bug fixes and performance improvements").strip,
      "fr-FR" => (ENV["RELEASE_NOTES_FR"] || "Corrections de bugs et ameliorations des performances").strip
    }
  end

  private_lane :localized_testflight_build_info do |options|
    notes = options[:release_notes] || localized_release_notes
    notes.each_with_object({}) do |(locale, text), build_info|
      build_info[locale] = { whats_new: text }
    end
  end

  private_lane :build_ipa do
    setup_asc_key

    # Build Flutter before Xcode archive (generates Generated.xcconfig + framework).
    # Running in unbundled env avoids Bundler intercepting `pod` when fastlane is
    # invoked with `bundle exec`.
    Dir.chdir("../..") do
      UI.user_error!("SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT must be set") unless
        ENV['SENTRY_AUTH_TOKEN'] && ENV['SENTRY_ORG'] && ENV['SENTRY_PROJECT']

      flutter_args = [
        "flutter", "build", "ios", "--release", "--no-codesign",
        "--split-debug-info=build/debug-info",
        "--dart-define=SENTRY_DSN=#{ENV['SENTRY_DSN'] || ''}",
        "--dart-define=SENTRY_ENVIRONMENT=#{ENV['SENTRY_ENVIRONMENT'] || 'production'}"
      ]
      if defined?(Bundler)
        Bundler.with_unbundled_env do
          sh(*flutter_args)
        end
        sh("dart", "run", "sentry_dart_plugin")
      else
        sh(*flutter_args)
        sh("dart", "run", "sentry_dart_plugin")
      end
    end

    # Build number is managed from TestFlight (independent of pubspec build number)
    app_id = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)
    latest = latest_testflight_build_number(app_identifier: app_id) || 0
    increment_build_number(
      xcodeproj: "Runner.xcodeproj",
      build_number: latest + 1
    )
    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Runner",
      export_options: {
        signingStyle: "automatic",
        signingCertificate: "Apple Distribution",
        teamID: "WM42CA5NH5"
      }
    )
    lane_context[SharedValues::IPA_OUTPUT_PATH]
  end

  private_lane :upload_to_store do |options|
    destination = options[:destination]
    ipa_path = options[:ipa]
    changelog = options[:changelog]
    localized_build_info = options[:localized_build_info] || {}
    app_store_options = options[:app_store_options] || {}

    UI.user_error!("ipa path is required") if ipa_path.nil?
    UI.user_error!("destination must be :testflight or :app_store") unless [:testflight, :app_store].include?(destination)

    setup_asc_key

    case destination
    when :testflight
      upload_to_testflight(
        ipa: ipa_path,
        changelog: changelog,
        localized_build_info: localized_build_info
      )
    when :app_store
      upload_to_app_store(
        { ipa: ipa_path }.merge(app_store_options)
      )
    end
  end

  desc "Build and distribute to TestFlight."
  lane :testflight do
    ipa_path = build_ipa
    release_notes = localized_release_notes
    upload_to_store(
      destination: :testflight,
      ipa: ipa_path,
      changelog: release_notes["en-US"],
      localized_build_info: localized_testflight_build_info(
        release_notes: release_notes
      )
    )
  end

  desc "Build and submit to App Store review with manual release."
  lane :app_store do
    ipa_path = build_ipa
    release_notes = localized_release_notes
    upload_to_store(
      destination: :app_store,
      ipa: ipa_path,
      app_store_options: {
        skip_metadata: true,
        skip_screenshots: true,
        precheck_include_in_app_purchases: false,
        release_notes: release_notes,
        submit_for_review: true,
        automatic_release: false
      }
    )
  end
end
